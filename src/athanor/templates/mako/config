# Generated by athanor transmute ({{ label }}). Edits are overwritten.
# Vellum at 36px (27pt), three times its 12px em, like the status line.
font=Vellum 27
background-color={{ bar }}
text-color={{ fg }}
border-color={{ border }}
border-size=2
border-radius=0
padding=4,24
margin=0
outer-margin=12,0,0,0
# The message line sits over the status line's column, not across the whole screen.
anchor=top-center
width=3200
height=52
icons=0
max-visible=1
format=%s: %b
default-timeout=8000

[body=""]
format=%s

[urgency=critical]
text-color={{ bar_warn }}
default-timeout=0

[hidden]
format=<span background="{{ fg }}" foreground="{{ bar }}">--More--</span> (%h)
